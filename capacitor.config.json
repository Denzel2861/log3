{
  "appId": "com.logbook.attachment",
  "appName": "Attachment Log Book",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#283265",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
